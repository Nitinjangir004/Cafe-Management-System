# Stage 1: Build the application
FROM maven:3.9.9-eclipse-temurin-21-jammy AS build
WORKDIR /app

# Copy pom.xml to cache dependency downloads
COPY pom.xml .
RUN mvn dependency:go-offline -B || true

# Copy project source and build package
COPY src ./src
RUN mvn clean package -DskipTests

# Stage 2: Lightweight runtime environment
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

# Render dynamically binds the PORT environment variable
ENV PORT=8080
EXPOSE ${PORT}

# Copy executable jar from the build stage
COPY --from=build /app/target/*.jar app.jar

# Container-aware memory allocation (optimized for Render free/starter tiers)
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Dserver.port=${PORT} -jar app.jar"]
